# Generate with: openssl rand -base64 32
EMAIL_SETTINGS_ENCRYPTION_KEY=""
# Independent AES-256-GCM key for 15-minute Dashboard query cursors.
# Generate with: openssl rand -base64 32
# Keep false until proxy/CDN/Next q+after redaction/no-log, APM/RUM suppression,
# and Dashboard Referrer-Policy: no-referrer have been operationally verified.
DASHBOARD_COMMON_QUERY_PRODUCTS_READY="false"
DASHBOARD_COMMON_QUERY_DEALERS_READY="false"
DASHBOARD_AUDIT_FOUNDATION_READY="false"
DASHBOARD_ASYNC_JOB_FOUNDATION_READY="false"
# JSON keyset: {"activeKid":"...","keys":[{"kid":"...","key":"base64-32-bytes","mode":"active|verify-only"}]}
ASYNC_JOB_IDEMPOTENCY_KEYS=""
DASHBOARD_WORK_QUEUE_FOUNDATION_READY="false"
WORK_QUEUE_DEDUP_KEYS=""
# Compact JSON keyset; exactly one active key, optional decrypt-only previous keys.
DASHBOARD_QUERY_CURSOR_KEYS=""
