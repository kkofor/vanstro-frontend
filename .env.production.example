VANSTRO_RUNTIME_MODE="deployment"
NODE_ENV="production"
DATABASE_URL="postgresql://REPLACE@db.example.com:5432/vanstro?sslmode=require"
API_HOST="0.0.0.0"
API_PORT="4000"
PUBLIC_APP_URL="https://vanstro.ca"
TRUST_PROXY_HEADERS="false"
VANSTRO_CORS_ORIGINS="https://vanstro.ca,https://www.vanstro.ca"

SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="REPLACE_WITH_SECRET_MANAGER_VALUE"
PAYMENT_CALLBACK_SECRET="REPLACE_WITH_32_PLUS_CHARACTER_SECRET"
ERP_WEBHOOK_SECRET="REPLACE_WITH_32_PLUS_CHARACTER_SECRET"
EMAIL_SETTINGS_ENCRYPTION_KEY="REPLACE_WITH_BASE64_32_BYTE_KEY"
# Enable only after verified query/cursor log redaction and Dashboard no-referrer policy.
DASHBOARD_COMMON_QUERY_PRODUCTS_READY="false"
DASHBOARD_COMMON_QUERY_DEALERS_READY="false"
DASHBOARD_AUDIT_FOUNDATION_READY="false"
DASHBOARD_ASYNC_JOB_FOUNDATION_READY="false"
ASYNC_JOB_IDEMPOTENCY_KEYS=""
DASHBOARD_WORK_QUEUE_FOUNDATION_READY="false"
WORK_QUEUE_DEDUP_KEYS=""
DASHBOARD_QUERY_CURSOR_KEYS='{"activeKid":"2026-08","keys":[{"kid":"2026-08","key":"REPLACE_WITH_CANONICAL_BASE64_32_BYTE_KEY","mode":"active"}]}'

ENABLE_PAYMENT_SIMULATION="false"
ENABLE_DEMO_INTEGRATIONS="false"
NEXT_PUBLIC_ENABLE_PAYMENT_SIMULATION="false"
NEXT_PUBLIC_DEMO_READ_ONLY="false"
NEXT_PUBLIC_API_BASE_URL="/api/v1"
VANSTRO_WEBSITE_API_BASE_URL="https://vanstro.ca/api/v1"
VANSTRO_API_BASE_URL="http://api:4000/api/v1"
VANSTRO_SERVICE_ACCOUNT_TOKEN="REPLACE_WITH_SCOPED_SERVICE_ACCOUNT_TOKEN"

CANADA_POST_API_KEY="REPLACE_WITH_SECRET_MANAGER_VALUE"
MONERIS_ENVIRONMENT="prod"
MONERIS_STORE_ID="REPLACE_WITH_SECRET_MANAGER_VALUE"
MONERIS_API_TOKEN="REPLACE_WITH_SECRET_MANAGER_VALUE"
MONERIS_CHECKOUT_ID="REPLACE_WITH_SECRET_MANAGER_VALUE"
NEXT_PUBLIC_MONERIS_ENVIRONMENT="prod"
NEXT_PUBLIC_MONERIS_CHECKOUT_JS="https://gateway.moneris.com/chktv2/js/chkt_v2.00.js"

ERP_PRODUCT_API_BASE_URL="https://erp.example.com/api/Product"
ERP_API_BASE_URL="https://REPLACE_WITH_ERP_HOST/api/v1"
ERP_SERVICE_TOKEN="REPLACE_WITH_32_PLUS_CHARACTER_SECRET"
ERP_LOCK_TTL_MS="900000"
ERP_MAX_ATTEMPTS="5"
CATALOG_SYNC_INTERVAL_MS="21600000"

SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="notifications@vanstro.ca"
SMTP_PASSWORD="REPLACE_WITH_SECRET_MANAGER_VALUE"
SMTP_FROM="VanStro <notifications@vanstro.ca>"
SMTP_REQUIRE_TLS="true"
EMAIL_LOCK_TTL_MS="900000"
EMAIL_MAX_ATTEMPTS="5"

WORKER_POLL_INTERVAL_MS="30000"
INVENTORY_SNAPSHOT_TTL_MS="300000"
DELIVERY_FLAT_FEE_CENTS="1500"
