FROM node:22.22.0-bookworm-slim@sha256:dd9d21971ec4395903fa6143c2b9267d048ae01ca6d3ea96f16cb30df6187d94 AS build
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY apps/worker/src/media-sandbox-launcher.c /tmp/media-sandbox-launcher.c
RUN gcc -O2 -Wall -Werror -o /usr/local/bin/media-sandbox-launcher /tmp/media-sandbox-launcher.c
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/worker/package.json apps/worker/package.json
RUN corepack enable && pnpm install --frozen-lockfile --filter @vanstro/worker --prod
FROM node:22.22.0-bookworm-slim@sha256:dd9d21971ec4395903fa6143c2b9267d048ae01ca6d3ea96f16cb30df6187d94
RUN useradd --system --uid 10001 --home-dir /nonexistent --shell /usr/sbin/nologin parser
WORKDIR /app
COPY --from=build /usr/local/bin/media-sandbox-launcher /usr/local/bin/media-sandbox-launcher
COPY --from=build /app/node_modules /app/node_modules
COPY --from=build /app/apps/worker/node_modules /app/apps/worker/node_modules
COPY apps/worker/src/media-parser-child.mjs /app/apps/worker/src/media-parser-child.mjs
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/media-sandbox-launcher", "/app/apps/worker/src/media-parser-child.mjs"]
