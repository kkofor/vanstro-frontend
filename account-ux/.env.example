# Committed .env already has QA sandbox Moneris + ACS for this prototype.
# Override with .env.local (gitignored) or host env. Do not reuse these in production.

MONERIS_ENV=qa
# MONERIS_ENV=prod

# Developer Portal → Access & Credentials (OAuth + API keys)
MONERIS_STORE_ID=
MONERIS_MERCHANT_ID=
MONERIS_CLIENT_ID=
MONERIS_CLIENT_SECRET=
MONERIS_API_KEY_PRIMARY=
MONERIS_API_KEY_SECONDARY=

# Hosted Tokenization profile (MRC → Admin → Hosted Tokenization)
# Channel 1: customer checkout. Source Domain must match the page origin.
MONERIS_HT_PROFILE_ID=

# Moneris Go Cloud — channel 2: dealer My account → Pay (Vanstro-owned terminals)
MONERIS_GO_API_TOKEN=
MONERIS_GO_IST_CONFIG=
# MONERIS_GO_STORE_ID=   # defaults to MONERIS_STORE_ID
# dealerId:terminalId,...
MONERIS_GO_TERMINALS=MB-YUAN:00000000

# HMAC for Go postback URLs and invoice PDF links in email. Required for live Go.
# Localhost defaults in scripts/load-env.mts. Never reuse the default in production.
VANSTRO_LINK_SECRET=

# Dev only: mock card box + mock POS approval. Unset for live sandbox/prod.
# MONERIS_MOCK=1

VANSTRO_GST_HST_BN=71411 2364 RT0001
VANSTRO_QST_BN=
RECEIPT_FROM=Vanstro Global Supply <receipts@mail.vanstro.ca>
EMAIL_FROM=Vanstro Global Supply <no-reply@mail.vanstro.ca>
EMAIL_REPLY_TO=support@vanstro.ca
APP_URL=https://account.vanstro.ca

# Azure Communication Services Email
AZURE_COMMUNICATION_CONNECTION_STRING=

# Optional: redirect all outbound mail in non-prod
# MAIL_REDIRECT_TO=

PORT=8787
# Default is loopback. Set 0.0.0.0 only behind a reverse proxy you control.
# BIND_HOST=127.0.0.1
# Only when the reverse proxy overwrites X-Forwarded-For (otherwise clients can spoof their IP).
# TRUST_PROXY=1
# CHROME_PATH=
# CHROME_NO_SANDBOX=1
