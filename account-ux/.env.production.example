# Production-only environment template. Keys only; never commit real values.
# The production service must run on the same-origin loopback upstream.
APP_URL=https://vanstro.ca
BIND_HOST=127.0.0.1
PORT=
# nginx sets X-Forwarded-For to $remote_addr (overwrite, not append); trust it.
TRUST_PROXY=1

# Production must not set MONERIS_MOCK; use the real payment channel.
MONERIS_ENV=
MONERIS_STORE_ID=
MONERIS_MERCHANT_ID=
MONERIS_CLIENT_ID=
MONERIS_CLIENT_SECRET=
MONERIS_API_KEY_PRIMARY=
MONERIS_API_KEY_SECONDARY=
MONERIS_API_TOKEN=
MONERIS_CHECKOUT_ID=
MONERIS_HT_PROFILE_ID=
# Hosted Tokenization Source Domain must be exactly https://vanstro.ca.
MONERIS_GO_API_TOKEN=
MONERIS_GO_IST_CONFIG=
MONERIS_GO_TERMINALS=

# Required for production links; do not commit the real value.
VANSTRO_LINK_SECRET=

# ACS is production mail: do not set MAIL_REDIRECT_TO.
AZURE_COMMUNICATION_CONNECTION_STRING=
RECEIPT_FROM=
EMAIL_FROM=
EMAIL_REPLY_TO=
VANSTRO_GST_HST_BN=
VANSTRO_QST_BN=
# Do not set MONERIS_MOCK=
# Do not set MAIL_REDIRECT_TO=
