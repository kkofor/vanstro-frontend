{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "preserve",
    "types": ["node"],
    "paths": { "@/*": ["./shadcn/*"] }
  },
  "include": ["shadcn/lib/**/*.ts", "shadcn/emails/**/*.ts", "shadcn/app/api/**/*.ts", "scripts/**/*.mts"],
  "exclude": ["node_modules", "shadcn/components"]
}
