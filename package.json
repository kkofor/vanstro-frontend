{
  "name": "vanstro-frontend",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "next build && node --experimental-strip-types scripts/localize-static-html.mjs",
    "start": "next start",
    "typecheck": "pnpm run typecheck:web && pnpm --filter @vanstro/db typecheck && pnpm --filter @vanstro/api typecheck && pnpm --filter @vanstro/worker typecheck && pnpm --filter @vanstro/cli typecheck",
    "typecheck:web": "tsc --noEmit",
    "qa:seo-security": "node qa/check-seo-security.mjs",
    "qa:seo-artifacts": "node qa/check-seo-artifacts.mjs",
    "qa:fr-html-language": "node qa/check-fr-html-language.mjs",
    "qa:fr-ca-display-format": "node --experimental-strip-types scripts/verify-fr-ca-display-format.mts",
    "test:products": "node --experimental-strip-types scripts/verify-product-localization.mts && node --experimental-strip-types scripts/verify-p0-product-fixes.mts",
    "qa:404-artifacts": "node qa/check-404-artifacts.mjs && node qa/check-static-404-fallback.mjs",
    "qa:browser-current-tree": "node qa/current-tree-browser-qa.mjs",
    "qa:error-localization": "node --experimental-strip-types scripts/verify-runtime-error-localization.mts",
    "test:final-review": "node --experimental-strip-types scripts/verify-final-review-transactional-fixes.mts",
    "test:functional-consent": "node --experimental-strip-types scripts/verify-functional-consent-storage.mts",
    "test:careers-contact-privacy": "node --experimental-strip-types scripts/verify-careers-contact-privacy.mts",
    "qa:careers-contact-privacy-html": "node --experimental-strip-types scripts/verify-careers-contact-privacy.mts out",
    "test:api": "pnpm --filter @vanstro/db build && set -a; [ -f .env ] && . ./.env; set +a; pnpm --filter @vanstro/api test",
    "test:db": "pnpm --filter @vanstro/db test",
    "test:worker": "pnpm --filter @vanstro/db build && pnpm --filter @vanstro/worker test",
    "qa:backend": "pnpm run typecheck:backend && pnpm run test:db && pnpm run test:api && pnpm run test:worker && pnpm run api:smoke",
    "typecheck:backend": "pnpm --filter @vanstro/db typecheck && pnpm --filter @vanstro/api typecheck && pnpm --filter @vanstro/worker typecheck && pnpm --filter @vanstro/cli typecheck",
    "build:backend": "pnpm --filter @vanstro/db build && pnpm --filter @vanstro/api build && pnpm --filter @vanstro/worker build && pnpm --filter @vanstro/cli build",
    "generate:openapi": "node --experimental-strip-types scripts/generate-openapi.mts",
    "preflight:production": "node --experimental-strip-types scripts/preflight-production.mts",
    "migrate:production": "node --experimental-strip-types scripts/migrate-production.mts",
    "qa:local-staging": "node --experimental-strip-types scripts/local-staging-e2e.mts",
    "stack:dev": "pnpm api:dev & pnpm worker:dev & pnpm dev",
    "demo:api": "set -a; . ./.env.demo; set +a; pnpm --filter @vanstro/api dev",
    "demo:worker": "set -a; . ./.env.demo; set +a; pnpm --filter @vanstro/worker dev",
    "demo:erp": "set -a; . ./.env.demo; set +a; pnpm --filter @vanstro/erp-mock start",
    "demo:web": "set -a; . ./.env.demo; set +a; pnpm dev",
    "test:product-identifiers": "node --experimental-strip-types scripts/verify-p0-product-fixes.mts",
    "test:package-contracts": "node --experimental-strip-types --test qa/package-a-contracts.test.ts",
    "qa:source": "pnpm run typecheck && pnpm run qa:seo-security && pnpm run test:api && pnpm run test:functional-consent && pnpm run test:final-review && pnpm run test:product-identifiers && pnpm run test:package-contracts && pnpm run qa:error-localization && pnpm run qa:fr-ca-display-format",
    "qa:artifacts": "pnpm run qa:seo-artifacts && pnpm run qa:fr-html-language && pnpm run qa:404-artifacts && pnpm run qa:careers-contact-privacy-html && pnpm run qa:browser-current-tree",
    "qa:ci": "pnpm run qa:source && pnpm run build:pages && pnpm run qa:artifacts",
    "api:dev": "set -a; [ -f .env ] && . ./.env; set +a; pnpm --filter @vanstro/api dev",
    "api:smoke": "set -a; [ -f .env ] && . ./.env; set +a; pnpm --filter @vanstro/api smoke",
    "worker:dev": "set -a; [ -f .env ] && . ./.env; set +a; pnpm --filter @vanstro/worker dev",
    "worker:once": "set -a; [ -f .env ] && . ./.env; set +a; pnpm --filter @vanstro/worker once",
    "db:generate": "pnpm --filter @vanstro/db prisma:generate",
    "db:migrate": "set -a; [ -f .env ] && . ./.env; set +a; pnpm --filter @vanstro/db prisma:migrate",
    "db:seed": "set -a; [ -f .env ] && . ./.env; set +a; pnpm --filter @vanstro/db db:seed"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^1.23.0",
    "next": "^16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.3"
  }
}
