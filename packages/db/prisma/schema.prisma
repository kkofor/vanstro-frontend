generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserKind {
  customer
  admin
}

enum UserStatus {
  active
  invited
  suspended
  archived
}

enum ServiceAccountStatus {
  active
  disabled
}

enum ServiceAccountEnvironment {
  production
  staging
  development
  test
}

enum OutboxStatus {
  pending
  running
  sent
  retry_wait
  failed
  cancelled
}

enum ErpSyncStatus {
  pending
  running
  retry_wait
  succeeded
  failed
  cancelled
}

enum ErpSyncJobType {
  order_create
  customer_sync
  inventory_release
}

enum PaymentSessionStatus {
  pending
  paid
  failed
  expired
  reconciliation_required
  refund_pending
  refund_processing
  refunded
  refund_failed
}

enum PaymentEventType {
  provider_confirmed
  order_created
  reconciliation_required
  refund_requested
  refunded
  refund_failed
}

enum OrderStatus {
  pending_payment
  paid
  processing
  fulfilled
  cancelled
  payment_expired
}

enum FulfillmentType {
  pickup
  delivery
}

enum InventoryReservationStatus {
  active
  released
  consumed
  expired
}

enum DealerStatus {
  active
  inactive
}

enum DealerMembershipStatus {
  invited
  active
  suspended
  revoked
}

enum DealerLocationStatus {
  active
  inactive
}

enum CatalogItemStatus {
  draft
  active
  archived
}

enum PriceStatus {
  draft
  active
  archived
}

enum PromotionStatus {
  draft
  active
  archived
}

enum ContactLeadStatus {
  new
  routed
  closed
  spam
}

enum DealerApplicationStatus {
  submitted
  under_review
  approved
  rejected
  archived
}

enum ProductReviewStatus {
  pending
  published
  rejected
  archived
}

enum SupportHandoffStatus {
  new
  in_progress
  resolved
  closed
}

enum CrmContactStage {
  registered
  engaged
  checkout_started
  customer
  high_intent
  archived
}

enum CrmContactSource {
  registration
  contact_form
  guest_checkout
}

enum CrmErpSyncStatus {
  none
  queued
  synced
  failed
}

enum CrmContactEventType {
  registered
  login
  cart_add
  checkout_started
  order_paid
  favorite_add
  note
  stage_change
  erp_promoted
}

model User {
  id                       String               @id @default(uuid())
  email                    String               @unique
  kind                     UserKind
  status                   UserStatus           @default(active)
  emailVerifiedAt          DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  adminProfile             AdminProfile?
  auditLogs                AuditLog[]
  authIdentities           AuthIdentity[]
  addresses                CustomerAddress[]
  carts                    Cart[]
  customerProfile          CustomerProfile?
  erpCustomerLinks         ErpCustomerLink[]
  loginEvents              LoginEvent[]
  dealerMemberships        DealerMembership[]   @relation("DealerMembershipSubject")
  dealerMembershipsCreated DealerMembership[]   @relation("DealerMembershipCreator")
  passwordCredential       PasswordCredential?
  passwordResetTokens      PasswordResetToken[]
  paymentSessions          PaymentSession[]
  orders                   Order[]
  favorites                Favorite[]
  refreshSessions          RefreshSession[]
  userRoles                UserRole[]
  crmContact               CrmContact?
  privacyRequests          PrivacyRequest[]
  crmContactsOwned         CrmContact[]         @relation("CrmContactOwner")
  crmTasksAssigned         CrmTask[]            @relation("CrmTaskAssignee")
  workQueueAssignments     WorkQueueItem[]      @relation("WorkQueueAssignee")
  inAppNotifications       InAppNotification[]  @relation("NotificationRecipient")

  @@map("users")
}

model Category {
  id          String               @id @default(uuid())
  slug        String               @unique
  name        String
  description String?
  parentId    String?
  sortOrder   Int                  @default(0)
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  parent      Category?            @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[]           @relation("CategoryTree")
  products    Product[]
  erpMappings ErpCategoryMapping[]

  @@map("categories")
}

model Product {
  id                     String                 @id @default(uuid())
  slug                   String                 @unique
  name                   String
  shortDescription       String?
  description            String?
  status                 CatalogItemStatus      @default(draft)
  categoryId             String?
  brand                  String?
  manufacturerPartNumber String?
  subCategoryKey         String?
  unit                   String?
  dimensions             String?
  finish                 String?
  colorName              String?
  colorHex               String?
  packageQuantity        Json?
  finishOptions          Json?
  productHighlights      Json?
  documents              Json?
  supportLinks           Json?
  recommendations        Json?
  certificationRequired  Boolean                @default(false)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  assets                 ProductAsset[]
  category               Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  reviews                ProductReview[]
  favorites              Favorite[]
  skus                   PlatformSku[]
  specifications         ProductSpecification[]

  @@index([status, categoryId])
  @@map("products")
}

model PlatformSku {
  id                     String                 @id @default(uuid())
  productId              String
  skuCode                String                 @unique
  name                   String
  manufacturerPartNumber String?
  status                 CatalogItemStatus      @default(active)
  attributes             Json?
  sortOrder              Int                    @default(0)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  assets                 ProductAsset[]
  erpMappings            ProductSkuErpMapping[]
  prices                 Price[]
  cartItems              CartItem[]
  inventoryReservations  InventoryReservation[]
  inventorySnapshots     InventorySnapshot[]
  orderItems             OrderItem[]
  product                Product                @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, skuCode])
  @@map("platform_skus")
}

model Cart {
  id              String           @id @default(uuid())
  userId          String?          @unique
  guestToken      String?          @unique
  currency        String           @default("CAD")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  items           CartItem[]
  paymentSessions PaymentSession[]
  user            User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("carts")
}

model CartItem {
  id        String      @id @default(uuid())
  cartId    String
  skuId     String
  quantity  Int
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  cart      Cart        @relation(fields: [cartId], references: [id], onDelete: Cascade)
  sku       PlatformSku @relation(fields: [skuId], references: [id], onDelete: Restrict)

  @@unique([cartId, skuId])
  @@map("cart_items")
}

model InventorySnapshot {
  id               String          @id @default(uuid())
  skuId            String
  dealerLocationId String?
  quantityOnHand   Int             @default(0)
  quantityReserved Int             @default(0)
  updatedAt        DateTime        @default(now())
  dealerLocation   DealerLocation? @relation(fields: [dealerLocationId], references: [id], onDelete: SetNull)
  sku              PlatformSku     @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@unique([skuId, dealerLocationId], map: "inventory_snapshots_sku_dealer_unique")
  @@map("inventory_snapshots")
}

model InventoryReservation {
  id               String                     @id @default(uuid())
  skuId            String
  dealerLocationId String?
  paymentSessionId String?
  ownerToken       String?
  quantity         Int
  status           InventoryReservationStatus @default(active)
  expiresAt        DateTime
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  dealerLocation   DealerLocation?            @relation(fields: [dealerLocationId], references: [id], onDelete: SetNull)
  paymentSession   PaymentSession?            @relation(fields: [paymentSessionId], references: [id], onDelete: SetNull)
  sku              PlatformSku                @relation(fields: [skuId], references: [id], onDelete: Restrict)

  @@index([status, expiresAt])
  @@index([paymentSessionId])
  @@index([skuId, dealerLocationId, status])
  @@map("inventory_reservations")
}

model PaymentSession {
  id                    String                 @id @default(uuid())
  userId                String?
  cartId                String?
  guestEmail            String
  guestFirstName        String
  guestLastName         String
  guestPhone            String
  guestOrderToken       String
  idempotencyKey        String?                @unique
  requestHash           String?
  paymentInit           Json?
  status                PaymentSessionStatus   @default(pending)
  fulfillment           FulfillmentType
  paymentMethod         String
  notes                 String?
  shippingAddressLine1  String?
  shippingAddressLine2  String?
  shippingCity          String?
  shippingProvince      String?
  shippingPostalCode    String?
  shippingCountry       String?                @default("CA")
  dealerLocationId      String?
  items                 Json
  subtotalCents         Int
  discountCents         Int                    @default(0)
  promotionKey          String?
  taxCents              Int                    @default(0)
  shippingCents         Int                    @default(0)
  totalCents            Int
  currency              String                 @default("CAD")
  providerPaymentId     String?                @unique
  expiresAt             DateTime
  paidAt                DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  cart                  Cart?                  @relation(fields: [cartId], references: [id], onDelete: SetNull)
  inventoryReservations InventoryReservation[]
  paymentEvents         PaymentEvent[]
  order                 Order?
  user                  User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
  @@index([cartId, status])
  @@map("payment_sessions")
}

model PaymentEvent {
  id               String           @id @default(uuid())
  paymentSessionId String
  type             PaymentEventType
  providerEventId  String?
  amountCents      Int?
  currency         String?
  payload          Json?
  createdAt        DateTime         @default(now())
  paymentSession   PaymentSession   @relation(fields: [paymentSessionId], references: [id], onDelete: Cascade)

  @@unique([paymentSessionId, type, providerEventId])
  @@index([type, createdAt])
  @@map("payment_events")
}

model Order {
  id                   String             @id @default(uuid())
  userId               String?
  email                String
  firstName            String
  lastName             String
  phone                String
  guestOrderToken      String
  guestTokenExpiresAt  DateTime?
  guestTokenRevokedAt  DateTime?
  paymentSessionId     String             @unique
  status               OrderStatus        @default(paid)
  fulfillment          FulfillmentType
  paymentMethod        String
  notes                String?
  shippingAddressLine1 String?
  shippingAddressLine2 String?
  shippingCity         String?
  shippingProvince     String?
  shippingPostalCode   String?
  shippingCountry      String?            @default("CA")
  dealerLocationId     String?
  subtotalCents        Int
  discountCents        Int                @default(0)
  promotionKey         String?
  taxCents             Int                @default(0)
  shippingCents        Int                @default(0)
  totalCents           Int
  currency             String             @default("CAD")
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  items                OrderItem[]
  statusEvents         OrderStatusEvent[]
  erpOrderLink         ErpOrderLink?
  paymentSession       PaymentSession     @relation(fields: [paymentSessionId], references: [id], onDelete: Restrict)
  user                 User?              @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@index([guestOrderToken])
  @@map("orders")
}

model OrderItem {
  id             String       @id @default(uuid())
  orderId        String
  skuId          String?
  skuCode        String
  productName    String
  quantity       Int
  unitPriceCents Int
  lineTotalCents Int
  currency       String       @default("CAD")
  createdAt      DateTime     @default(now())
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku            PlatformSku? @relation(fields: [skuId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusEvent {
  id        String      @id @default(uuid())
  orderId   String
  status    OrderStatus
  source    String
  payload   Json?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_events")
}

model ProductAsset {
  id        String       @id @default(uuid())
  productId String
  skuId     String?
  url       String
  altText   String?
  kind      String       @default("image")
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       PlatformSku? @relation(fields: [skuId], references: [id], onDelete: SetNull)

  @@unique([productId, url])
  @@map("product_assets")
}

model ProductSpecification {
  id        String   @id @default(uuid())
  productId String
  key       String
  value     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, key])
  @@map("product_specifications")
}

model Price {
  id              String      @id @default(uuid())
  key             String      @unique
  skuId           String
  currency        String      @default("CAD")
  amountCents     Int
  compareAtCents  Int?
  status          PriceStatus @default(active)
  effectiveFrom   DateTime?
  effectiveUntil  DateTime?
  source          String      @default("vanstro")
  externalVersion Int?
  sourceUpdatedAt DateTime?   @db.Timestamptz(3)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  sku             PlatformSku @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@index([status, currency])
  @@map("prices")
}

model Promotion {
  id                   String          @id @default(uuid())
  key                  String          @unique
  name                 String
  description          String?
  discountLabel        String?
  discountPercent      Int?
  minimumSubtotalCents Int?
  status               PromotionStatus @default(draft)
  startsAt             DateTime?
  endsAt               DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([status, startsAt, endsAt])
  @@map("promotions")
}

model ContactLead {
  id               String            @id @default(uuid())
  name             String
  email            String
  phone            String?
  topic            String
  city             String?
  preferredDealer  String?
  orderNumber      String?
  message          String
  locale           String?
  sourcePath       String?
  status           ContactLeadStatus @default(new)
  assignedToUserId String?
  assignedDealerId String?
  rawPayload       Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  notes            ContactLeadNote[]

  @@index([status, createdAt])
  @@map("contact_leads")
}

model ContactLeadNote {
  id            String      @id @default(uuid())
  contactLeadId String
  authorUserId  String?
  note          String
  createdAt     DateTime    @default(now())
  contactLead   ContactLead @relation(fields: [contactLeadId], references: [id], onDelete: Cascade)

  @@map("contact_lead_notes")
}

model CrmContact {
  id             String            @id @default(uuid())
  userId         String?           @unique
  email          String            @unique
  firstName      String?
  lastName       String?
  phone          String?
  stage          CrmContactStage   @default(registered)
  source         CrmContactSource
  erpSyncStatus  CrmErpSyncStatus  @default(none)
  ownerUserId    String?
  tags           String[]          @default([])
  lastActivityAt DateTime          @default(now())
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  user           User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  owner          User?             @relation("CrmContactOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  events         CrmContactEvent[]
  notes          CrmContactNote[]
  tasks          CrmTask[]

  @@index([stage, lastActivityAt])
  @@index([ownerUserId, lastActivityAt])
  @@map("crm_contacts")
}

model CrmTask {
  id             String     @id @default(uuid())
  contactId      String
  assigneeUserId String?
  title          String
  description    String?
  status         String     @default("open")
  dueAt          DateTime?
  completedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  contact        CrmContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignee       User?      @relation("CrmTaskAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)

  @@index([contactId, status, dueAt])
  @@index([assigneeUserId, status, dueAt])
  @@map("crm_tasks")
}

model CrmContactEvent {
  id          String              @id @default(uuid())
  contactId   String
  type        CrmContactEventType
  payload     Json?
  actorUserId String?
  createdAt   DateTime            @default(now())
  contact     CrmContact          @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, createdAt])
  @@index([contactId, type, createdAt])
  @@map("crm_contact_events")
}

model CrmContactNote {
  id           String     @id @default(uuid())
  contactId    String
  authorUserId String?
  note         String
  createdAt    DateTime   @default(now())
  contact      CrmContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, createdAt])
  @@map("crm_contact_notes")
}

model DealerApplication {
  id                         String                  @id @default(uuid())
  companyName                String
  contactName                String
  email                      String
  phone                      String
  website                    String?
  businessType               String?
  city                       String
  province                   String
  serviceArea                String?
  productFocus               String?
  capabilities               Json?
  message                    String?
  source                     String?
  applicationAcknowledgement Boolean                 @default(false)
  status                     DealerApplicationStatus @default(submitted)
  rawPayload                 Json?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  notes                      DealerApplicationNote[]

  @@index([status, createdAt])
  @@map("dealer_applications")
}

model DealerApplicationNote {
  id                  String            @id @default(uuid())
  dealerApplicationId String
  authorUserId        String?
  note                String
  createdAt           DateTime          @default(now())
  dealerApplication   DealerApplication @relation(fields: [dealerApplicationId], references: [id], onDelete: Cascade)

  @@map("dealer_application_notes")
}

model ProductReview {
  id            String              @id @default(uuid())
  productId     String
  rating        Int
  title         String?
  body          String
  nickname      String
  email         String
  topics        Json?
  acceptedTerms Boolean             @default(false)
  status        ProductReviewStatus @default(pending)
  moderatedAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  notes         ProductReviewNote[]
  product       Product             @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, status, createdAt])
  @@index([status, createdAt])
  @@map("product_reviews")
}

model ProductReviewNote {
  id              String        @id @default(uuid())
  productReviewId String
  authorUserId    String?
  note            String
  createdAt       DateTime      @default(now())
  productReview   ProductReview @relation(fields: [productReviewId], references: [id], onDelete: Cascade)

  @@map("product_review_notes")
}

model ProductSkuErpMapping {
  id           String      @id @default(uuid())
  skuId        String
  erpSystem    String
  erpSkuKey    String
  erpProductId Int?
  erpSkuId     Int?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  sku          PlatformSku @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@unique([skuId, erpSystem])
  @@unique([erpSystem, erpSkuKey])
  @@map("product_sku_erp_mappings")
}

model ErpCategoryMapping {
  id             String   @id @default(uuid()) @db.Uuid
  erpSystem      String
  erpCategoryKey String
  erpCategoryId  Int?
  categoryId     String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  category       Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([erpSystem, erpCategoryKey])
  @@unique([categoryId, erpSystem])
  @@map("erp_category_mappings")
}

model CustomerProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  firstName String?
  lastName  String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

model CustomerAddress {
  id           String   @id @default(uuid())
  userId       String
  label        String?
  firstName    String
  lastName     String
  phone        String?
  addressLine1 String
  addressLine2 String?
  city         String
  province     String
  postalCode   String
  country      String   @default("CA")
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
  @@map("customer_addresses")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("favorites")
}

model AdminProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  displayName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_profiles")
}

model AuthIdentity {
  id             String   @id @default(uuid())
  userId         String
  provider       String
  providerUserId String
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@map("auth_identities")
}

model PasswordCredential {
  id           String   @id @default(uuid())
  userId       String   @unique
  algorithm    String
  passwordHash String
  passwordSalt String
  iterations   Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_credentials")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model RefreshSession {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_sessions")
}

model Role {
  id                  String                 @id @default(uuid())
  key                 String                 @unique
  name                String
  description         String?
  isSystem            Boolean                @default(false)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  rolePermissions     RolePermission[]
  serviceAccountRoles ServiceAccountRole[]
  userRoles           UserRole[]
  membershipRoles     DealerMembershipRole[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid())
  key             String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
