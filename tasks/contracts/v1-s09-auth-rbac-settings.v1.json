        "maximum": 128,
        "default": 12,
        "consumer": "future registration and password-reset writes only"
      },
      "resetTokenTtlMinutes": {
        "type": "integer",
        "minimum": 5,
        "maximum": 31,
        "default": 30,
        "consumer": "future password-reset token issuance only"
      }
    },
    "sessionPolicy": {
      "sessionLifetimeMinutes": {
        "type": "integer",
        "minimum": 15,
        "maximum": 11520,
        "default": 10080,
        "consumer": "future login and refresh/rotation only"
      }
    },
    "unknownKeys": "reject",
    "secret": false,
    "sizeLimitBytes": 4096
  },
